{
  "expo": {
    "name": "hydra",
    "slug": "happy-water",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hydra",
    "userInterfaceStyle": "automatic",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#07182F"
    },
    "ios": {
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EAF6FB"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.kingaary.happywater"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/water_drop.wav"],
          "defaultChannel": "hydra-reminders-v2"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EAF6FB"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
  "url": "https://u.expo.dev/6cf9a35a-5a1a-4d64-8c38-151bc943205d"
},
"runtimeVersion": {
  "policy": "appVersion"
},
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6cf9a35a-5a1a-4d64-8c38-151bc943205d"
      }
    },
    "owner": "kingaary"
  }
}